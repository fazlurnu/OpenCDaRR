# macOS
.DS_Store

# Python bytecode / caches
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Tooling caches
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Experiment outputs — regenerated from config + seed + code-hash (design-philosophy #4),
# so they are products, not source. Provenance lives in the vault, not in git blobs.
results/
outputs/

# Obsidian — share config, ignore per-user workspace/cache state
vault/.obsidian/workspace.json
vault/.obsidian/workspace-mobile.json
vault/.obsidian/cache

# Reference papers — possibly confidential, kept out of git
vault/papers/

# handbook Monte-Carlo result cache (regenerated, not committed)
scripts/handbook/.mc_cache/

# opencdarr.cache disk store — pickled recorded runs, regenerated from config + seed + code-hash
.opencdarr_cache/

# Jupyter checkpoint snapshots (auto-created when a notebook runs)
.ipynb_checkpoints/
